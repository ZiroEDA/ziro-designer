{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -C designer build && test -f designer/dist/index.html && test -f designer/dist/sw.js || { echo \"Build output incomplete (designer/dist/index.html or sw.js missing): refusing to deploy a partial build.\"; exit 1; }",
  "outputDirectory": "designer/dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(assets/.*|workbox-[a-z0-9]+\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sw\\.js|registerSW\\.js|manifest\\.webmanifest|index\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "build": {
    "env": {
      "VITE_DEMOS_URL": "https://pub-ac941e05e1284f409be2ed74ddb151b3.r2.dev/demos",
      "VITE_MODELS3D_URL": "https://pub-ac941e05e1284f409be2ed74ddb151b3.r2.dev",
      "VITE_SYMBOLS_URL": "https://pub-ac941e05e1284f409be2ed74ddb151b3.r2.dev/symbols",
      "VITE_FOOTPRINTS_URL": "https://pub-ac941e05e1284f409be2ed74ddb151b3.r2.dev/footprints",
      "VITE_SENTRY_DSN": "https://42aff68d046ec2d4486c43b5a2eb3f3e@o4511797248327680.ingest.de.sentry.io/4511797282406480",
      "SENTRY_ORG": "ziroeda",
      "SENTRY_PROJECT": "javascript-react"
    }
  }
}
