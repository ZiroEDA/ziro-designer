{
  "name": "ziro-designer",
  "version": "0.0.0",
  "private": true,
  "description": "Ziro Designer, the browser-native, open-source electronics design suite from ZiroEDA.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "libraries:upload": "node --env-file=.env tools/libraries/upload.mjs",
    "libraries:verify": "node --env-file=.env tools/libraries/verify.mjs",
    "demos:upload": "node --env-file=.env tools/demos/upload.mjs",
    "demos:bundle": "node --env-file=.env tools/demos/bundle.mjs",
    "libraries:split": "node --env-file=.env tools/libraries/split_upload.mjs",
    "libraries:reindex": "node --env-file=.env tools/libraries/reindex.mjs",
    "libraries:bundle": "node --env-file=.env tools/libraries/bundle.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
