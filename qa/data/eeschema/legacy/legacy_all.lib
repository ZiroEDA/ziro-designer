EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# TESTPART
#
DEF TESTPART U 0 40 Y Y 2 L N
F0 "U" -300 350 60 H V L CNN
F1 "TESTPART" 100 350 60 H V L CNN
F2 "Package_DIP:DIP-8" 0 -400 60 H I C CIN
F3 "http://example.com/ds.pdf" 0 0 60 H I C CNN
F4 "user-value" 20 30 40 V I R TNB "MyField"
ALIAS TESTPART_ALT TESTPART_ALT2
$FPLIST
 DIP*
 SOIC*
$ENDFPLIST
DRAW
A 0 0 100 0 900 1 1 10 N 100 0 0 100
A 200 200 50 1800 2700 1 1 8 F
A -500 0 100 2700 450 1 1 10 N -500 -100 -429 71
A -800 0 100 1900 1700 1 1 10 N -898 -17 -898 17
T 0 -600 300 40 0 1 1 he''llo Normal 0 C C
C -200 -200 60 1 1 12 f
T 900 100 200 50 0 1 1 "Hello World" Italic 1 C C
T 0 -300 -100 40 0 2 1 Plain~Text Normal 0 L B
S -300 -300 300 300 1 1 6 N
P 4 1 1 5 -100 -100 0 100 100 -100 -100 -100 F
B 4 1 1 4 0 0 50 100 150 100 200 0
X ~ 1 -400 0 100 R 50 50 1 1 I
X NAME2 2 400 0 100 L 50 50 1 1 O I
X CLK 3 0 400 100 D 50 50 1 1 W CI
X NC 4 0 -400 100 U 50 50 2 1 N N
ENDDRAW
ENDDEF
#
# ~PWRTEST
#
DEF ~PWRTEST #PWR 0 0 N N 1 F P
F0 "#PWR" 0 -150 50 H I C CNN
F1 "~PWRTEST" 0 140 50 H V C CNN
F2 "~" 0 0 60 H V C CNN
F3 "" 0 0 60 H V C CNN
DRAW
P 2 0 1 0 -30 50 0 100 N
X PWR 1 0 0 0 U 50 50 0 0 W N
ENDDRAW
ENDDEF
