	(text ".param Qtc = 0.7071"
		(exclude_from_sim no)
		(at 182.245 128.905 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "0c66cfcd-4604-4dd4-9ddf-6b34b3101a40")
	)
	(text "Linkwitz-Riley Transform: equalize a driver in a sealed box to a different Q and cutoff frequency"
		(exclude_from_sim no)
		(at 123.19 111.125 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify top)
		)
		(uuid "14c98d33-e3d5-4e44-ba4d-537f8de93be4")
	)
	(text "Input Parameters"
		(exclude_from_sim no)
		(at 121.92 116.84 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
		)
		(uuid "1cc40b4f-fe33-41e1-bf9b-e812094d6a42")
	)
	(text "Input parameter"
		(exclude_from_sim no)
		(at 211.455 128.905 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
		)
		(uuid "27d100d6-4643-4773-a29a-c66e76af8af6")
	)
	(text ".param Vb  = Vas / ((Qtc/Qts) * (Qtc/Qts) - 1.)\n.param Fc   = Fs * sqrt(( Vas/Vb) + 1.) \n.param Lspk  = 1\n.param Cspk  = 1. / (39.47842 * Fc * Fc * Lspk)\n.param Rspk  = 6.2831853 * Fc / Qtc"
		(exclude_from_sim no)
		(at 179.705 132.8166 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "2b45e4e4-ceb9-4bf9-8727-54b894b13c54")
	)
	(text "This example schematic is supplied for informational/educational purposes only."
		(exclude_from_sim no)
		(at 154.305 182.245 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify top)
		)
		(uuid "43765652-e638-4979-a89b-67d66dc4dc04")
	)
	(text "Sealed Box"
		(exclude_from_sim no)
		(at 201.295 124.46 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify top)
		)
		(uuid "46cd4ec7-f400-4aa8-bc38-49462526e539")
	)
	(text ".param k   = (Fc0/Fcx-Qt0/Qtx)/(Qt0/Qtx-Fcx/Fc0)\n.param R1  = (1/(2*pi*Fc0*C2*(2*Qt0*(1+k))))\n.param R2  = 2*k*R1\n.param R3  = R1*(Fc0/Fcx)**2\n.param C1  = C2*(2*Qt0*(1+k))**2\n.param C3  = C1*(Fcx/Fc0)**2\n;.param gain=40*Log10(Fc0/Fcx) ; FYI"
		(exclude_from_sim no)
		(at 69.85 132.1816 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "5d8f2a63-5bdb-44de-9c14-abbc9f8c184e")
	)
	(text ".param Fs =95\n.param Qts=0.472\n.param Vas=0.04481"
		(exclude_from_sim no)
		(at 179.705 115.0366 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "6639226d-a9ca-4a6e-99de-bb65231297e0")
	)
	(text ".include ltspice_cmp/standard.dio\n.include ltspice_cmp/standard.bjt\n.include ltspice_cmp/standard.jft\n.include ltspice_cmp/standard.mos\n\n.subckt pwl_file outp outn file=\"\" timerelative=1\nAfs %vd([outp outn]) filesrc\n.model filesrc filesource (file={file} amploffset=[0] amplscale=[1] timeoffset=0 timescale=1 timerelative={timerelative})\n.ends\n"
		(exclude_from_sim no)
		(at 0 0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7722f93b-ee9e-443e-ac12-880cb626af4d")
	)
	(text "This is the theory of the PA system used in the 2015 World Circuit Seminar\nTour except (i) the electronics I traveled with include baffle step\ncompensation (ii) the microphone aperture was adjusted to add\n4dB @ 16kHz to enhance sibilance and (iii) the drivers were a vertical array."
		(exclude_from_sim no)
		(at 151.13 109.855 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify bottom)
		)
		(uuid "7732fbd8-d665-43cf-bbbc-9dc805b1e6e7")
	)
	(text "These voltage sources read\nout the component values to\nimplement the equalizer"
		(exclude_from_sim no)
		(at 131.445 172.8216 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify top)
		)
		(uuid "7b97cb81-9461-498f-acda-956de9c77ef9")
	)
	(text ".ac oct 10 10 10K"
		(exclude_from_sim no)
		(at 203.835 183.515 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "98edd715-b155-4f2d-81c1-494b31d88393")
	)
	(text "Voltage to Sound Pressure Level Equiv. Circuit"
