			)
			(justify top)
		)
		(uuid "d003e077-d08f-4f1f-863d-4f79d902f920")
	)
	(text ".param C2=.047u\n.param Fc0 = Fc      ; Fc untransformed\n.param Qt0 = Qtc     ; Qtc untransformed\n.param Fcx = 80       ; Fc transformed(chosen on spectral analysis of my voice)\n.param Qtx = 0.7071 ; Qtc transformed"
		(exclude_from_sim no)
		(at 69.215 115.0366 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
