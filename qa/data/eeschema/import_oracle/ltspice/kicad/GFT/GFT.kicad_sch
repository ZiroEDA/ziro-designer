	(text "This example shows how to simulate the quantities of the General Feedback Theorem, which are defined in the article\n R. David Middlebrook, \"The General Feedback Theorem: A Final Solution for Feedback Systems\", IEEE Microwave Magazine, vol. 7, no. 2, pp. 50-63, April 2006.\nThis article can be downloaded from http://resolver.caltech.edu/CaltechAUTHORS:MIDieeemm06 .\nSee also message 18008 of the independent LTspice users' group at http://groups.yahoo.com/group/LTspice where this method was originally presented by Frank Wiedmann."
		(exclude_from_sim no)
		(at 149.86 66.675 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify bottom)
		)
		(uuid "06efdc0f-cd3f-40ff-88a6-2b8f19894f6c")
	)
	(text ".param z=0"
		(exclude_from_sim no)
		(at 161.925 132.08 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "22ca70c2-fb02-4e61-82fd-c315e0fb93ad")
	)
	(text "* For this example, add the following definitions to the plot.defs file:\n* A() is an auxiliary quantity.\n* Dd() corresponds to D.\n* Hinf() corresponds to H_infinity.\n* All other function names are equal to those of the corresponding quantities.\n \n.func A()    =  V(o)@2*(V(y)@1*I(Viy)@3-V(y)@3*I(Viy)@1)+V(o)@1\n+ *(V(y)@3*I(Viy)@2-V(y)@2*I(Viy)@3)+V(o)@3\n+ *(V(y)@2*I(Viy)@1-V(y)@1*I(Viy)@2)\n.func Dd()   =  V(y)@1*I(Viy)@3-V(y)@3*I(Viy)@1\n.func H()    =  V(o)@2\n.func Hinf() =  A()/Dd()\n.func T()    = 1/(1/Dd()-1)\n.func Dn()   = H()/A()\n.func Tn()   = 1/(Dn()-1)\n.func D0()   = 1-Dd()\n.func H0()   = (H()-A())/D0()"
		(exclude_from_sim no)
		(at 69.215 76.3016 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "2c520870-150f-44dd-a461-36d98f39a3cc")
	)
	(text ".ac dec 100 100m 100G"
		(exclude_from_sim no)
		(at 161.925 137.16 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "3b0ee6d6-b1b5-4e27-9d66-ff8b564a7e3d")
	)
	(text ".include ltspice_cmp/standard.dio\n.include ltspice_cmp/standard.bjt\n.include ltspice_cmp/standard.jft\n.include ltspice_cmp/standard.mos\n\n.subckt pwl_file outp outn file=\"\" timerelative=1\nAfs %vd([outp outn]) filesrc\n.model filesrc filesource (file={file} amploffset=[0] amplscale=[1] timeoffset=0 timescale=1 timerelative={timerelative})\n.ends\n"
		(exclude_from_sim no)
		(at 0 0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b34afffe-b771-4b57-b6cd-490a5cca8dca")
	)
	(text ".step param z list -1 0 1"
		(exclude_from_sim no)
		(at 161.925 134.62 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "c0cf126c-4e96-4ce7-8180-a50c7155c22d")
	)
	(text "This example schematic is supplied for informational/educational purposes only.\nWe thank Frank Wiedmann for contributing this example."
		(exclude_from_sim no)
