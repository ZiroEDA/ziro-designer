	(text "Here the open loop gain is determined from the closed loop system[1].\nThe voltage gain and current gain are independently measured in\ntwo circuits identical except for the elements inserted into\nthe loop to make the measurements.  Then the open loop gain\ncan be plotted by plotting the quantity:\n \n((I(V3)/I(V4))*(-V(x)/V(y))-1)/((I(V3)/I(V4))+(-V(x)/V(y))+2)\n \nAlternatively, you can add the lines\n.func Gi()=I(V3)/I(V4)\n.func Gv()=-V(x)/V(y)\n.func middlebrook(x,y) = (x*y-1)/(x+y+2)\nto your plot.defs file and then plot the quantity\nmiddlebrook(Gi(),Gv())"
		(exclude_from_sim no)
		(at 106.045 59.1566 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "27112c0f-e380-4142-ab7f-bd8ea474bb23")
	)
	(text ".include ltspice_cmp/standard.dio\n.include ltspice_cmp/standard.bjt\n.include ltspice_cmp/standard.jft\n.include ltspice_cmp/standard.mos\n\n.subckt pwl_file outp outn file=\"\" timerelative=1\nAfs %vd([outp outn]) filesrc\n.model filesrc filesource (file={file} amploffset=[0] amplscale=[1] timeoffset=0 timescale=1 timerelative={timerelative})\n.ends\n"
		(exclude_from_sim no)
		(at 0 0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2dc67f17-de19-4d5b-9aee-17708f92e1b1")
	)
	(text "See the example file LoopGain2.asc for an improved technique."
		(exclude_from_sim no)
		(at 113.03 148.59 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "2fe404ae-6e76-49e1-8f32-df322bfbbced")
	)
	(text ".ac dec 30 .1 100Meg"
		(exclude_from_sim no)
		(at 112.395 134.62 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left)
		)
		(uuid "50f09b56-655f-4f3e-95d8-fd6bc599d89e")
	)
	(text "This example schematic is supplied for informational/educational purposes only."
		(exclude_from_sim no)
		(at 158.115 149.86 0)
		(effects
			(font
				(size 0.9144 0.9144)
			)
			(justify top)
		)
		(uuid "5671a6b2-3644-4a1b-b517-d8029a38e445")
	)
	(text "Elements added to \ncompute current gain\nGi=I(V3)/I(V4)"
		(exclude_from_sim no)
		(at 163.83 77.5716 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "8068dc2d-c6a0-4c72-98a1-cbb09b6be608")
	)
	(text "Element added to \ncompute voltage gain\nGv=-V(x)/V(y)"
		(exclude_from_sim no)
		(at 165.1 113.7666 0)
		(effects
			(font
				(size 1.0668 1.0668)
			)
			(justify left top)
		)
		(uuid "bf308759-52ba-4dfb-a815-f3160387f7d4")
	)
	(text "1] Middlebrook, R.D., \"Measurement of Loop Gain in Feedback Systems\", Int. J. Electronics, vol 38, No. 4, pp. 485-512, 1975"
		(exclude_from_sim no)
		(at 99.06 145.415 0)
		(effects
