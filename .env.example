# Credentials for the offline content pipelines under tools/ (symbol and
# footprint libraries, demo projects, 3D models). Nothing in the app reads this
# file: the browser app's own settings live in designer/.env.example.
#
# Copy it, fill it in, and it stays out of git:
#
#   cp .env.example .env
#   pnpm libraries:upload
#
# .env is gitignored. This repository is public, so never put real values in
# this example file, and never commit a filled-in copy.

# --- Cloudflare R2 -----------------------------------------------------------
# These are *R2 API tokens*, an S3-style key pair, not the Cloudflare API token
# that `wrangler login` or the dashboard's "API tokens" page gives you. The
# uploaders talk to R2's S3-compatible endpoint and sign with SigV4, which a
# Cloudflare API token cannot do.
#
# Create one at:
#   Cloudflare dashboard -> R2 -> API -> Manage API tokens -> Create API token
#   Permission: Object Read & Write, scoped to the bucket below.
#
# The Secret Access Key is shown once, at creation.

# Dashboard -> R2 -> Overview, in the sidebar under "Account details".
R2_ACCOUNT_ID=

# Shown when the token is created.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket the pipelines write to. Defaults to ziro-3dmodels when unset, which
# is where the symbol, footprint, 3D-model and demo objects all live today.
R2_BUCKET=ziro-3dmodels
