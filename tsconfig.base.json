{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "clipper-lib": ["./types/clipper-lib.d.ts"],
      "occt-import-js": ["./types/occt-import-js.d.ts"],
      "occt-import-js/dist/occt-import-js.wasm?url": ["./types/occt-import-js.d.ts"]
    }
  }
}
